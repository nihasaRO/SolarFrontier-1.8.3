// Generated by tools/make_project.py: the settings menu's texts, as lists of small chunks (16 options each).
import Toybox.Lang;
import Toybox.WatchUi;

module SetText {
    const IDS = [ Rez.JsonData.L2, Rez.JsonData.L5, Rez.JsonData.L6, Rez.JsonData.L11, Rez.JsonData.L12, Rez.JsonData.L13, Rez.JsonData.L14, Rez.JsonData.L16, Rez.JsonData.L17 ];
    const IDX = [ 100, 101, 0, 0, 0, 102, 103, 1, 2, 104, 105, 106, 107, 3, 3, 4, 4, 4, 5, 6, 108, 7, 8, 109, 110, 111, 112, 113, 114, 115, 116, 8 ]b;

    // setting i's options: an array of chunks (a computed list like "day" is one chunk)
    function list(i) as Lang.Array {
        var x = IDX[i];
        return ((x < 100) ? WatchUi.loadResource(IDS[x]) : (WatchUi.loadResource(Rez.JsonData.S) as Lang.Array)[x - 100]) as Lang.Array;
    }

    function title(i) as Lang.String {
        return (WatchUi.loadResource(Rez.JsonData.T) as Lang.Array)[i] as Lang.String;
    }

    function group(g) as Lang.String {
        return (WatchUi.loadResource(Rez.JsonData.G) as Lang.Array)[g] as Lang.String;
    }
}
